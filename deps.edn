{:paths ["src"]
 :deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}
 :aliases
 {;; Compile on change into public/js (unoptimized). Serve public/ separately.
  :dev {:main-opts ["-m" "cljs.main" "-co" "dev.edn" "-w" "src" "-c"]}
  ;; One optimized file, public/js/main.js.
  :release {:main-opts ["-m" "cljs.main" "-co" "release.edn" "-c"]}
  ;; Compile the tests; run them with `node target/test/test.js`.
  :test {:extra-paths ["test"]
         :main-opts ["-m" "cljs.main" "-co" "test.edn" "-c"]}}}
